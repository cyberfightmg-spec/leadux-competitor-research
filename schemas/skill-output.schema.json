{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leaduxai.id/schemas/skill-output.schema.json",
  "title": "LeadUX Research Skill Output",
  "type": "object",
  "required": ["skill", "status", "coverage", "sources", "claims", "artifacts", "data_gaps", "next_actions"],
  "properties": {
    "skill": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "partial", "degraded", "blocked"]},
    "coverage": {
      "type": "object",
      "required": ["attempted", "completed", "missing"],
      "properties": {
        "attempted": {"type": "array", "items": {"type": "string"}},
        "completed": {"type": "array", "items": {"type": "string"}},
        "missing": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "sources": {"type": "array", "items": {"type": "object"}},
    "claims": {"type": "array", "items": {"type": "object"}},
    "artifacts": {"type": "object"},
    "data_gaps": {"type": "array", "items": {"type": "object"}},
    "next_actions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
