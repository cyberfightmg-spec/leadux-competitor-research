{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leaduxai.id/schemas/competitor-research/content-performance-pattern.schema.json",
  "title": "LeadUX Content Performance Pattern",
  "type": "object",
  "required": ["pattern_id", "platform", "pattern_class", "accounts", "evidence_level", "confidence"],
  "properties": {
    "pattern_id": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "pattern_class": {"enum": ["SINGLE_OUTLIER", "REPEATED_ACCOUNT_PATTERN", "CROSS_ACCOUNT_PATTERN", "FIRST_PARTY_CONFIRMED_PATTERN"]},
    "accounts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "sample": {
      "type": "object",
      "properties": {
        "posts_analyzed": {"type": ["integer", "null"], "minimum": 0},
        "date_range": {"type": ["string", "null"]},
        "metric": {"type": ["string", "null"]},
        "baseline_method": {"type": ["string", "null"]},
        "baseline_value": {"type": ["number", "null"]},
        "coverage_notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "outlier_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["content_id"],
        "properties": {
          "content_id": {"type": "string"},
          "account": {"type": ["string", "null"]},
          "published_at": {"type": ["string", "null"]},
          "metric_name": {"type": ["string", "null"]},
          "metric_value": {"type": ["number", "null"]},
          "baseline_value": {"type": ["number", "null"]},
          "outlier_multiplier": {"type": ["number", "null"]},
          "source_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "mechanism": {
      "type": "object",
      "properties": {
        "topic": {"type": ["string", "null"]},
        "audience_problem": {"type": ["string", "null"]},
        "hook_pattern": {"type": ["string", "null"]},
        "angle": {"type": ["string", "null"]},
        "format": {"type": ["string", "null"]},
        "structure": {"type": ["string", "null"]},
        "proof_pattern": {"type": ["string", "null"]},
        "cta_pattern": {"type": ["string", "null"]},
        "visual_pattern": {"type": ["string", "null"]},
        "timing_dependency": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "evidence_level": {"enum": ["CONTENT_SIGNAL", "AUDIENCE_RESPONSE", "LEAD_SIGNAL", "BUSINESS_OUTCOME"]},
    "supporting_claim_ids": {"type": "array", "items": {"type": "string"}},
    "contradicting_claim_ids": {"type": "array", "items": {"type": "string"}},
    "transfer_assumptions": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "observed_at": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
