{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leaduxai.id/schemas/report.schema.json",
  "title": "LeadUX Competitor Research Report",
  "type": "object",
  "required": ["research_id", "integrity_status", "executive_findings", "data_gaps", "source_ids"],
  "properties": {
    "research_id": {"type": "string"},
    "integrity_status": {"enum": ["VERIFIED", "VERIFIED_WITH_GAPS", "DEGRADED", "INSUFFICIENT_EVIDENCE"]},
    "scope": {"type": "object"},
    "executive_findings": {"type": "array", "items": {"type": "object"}},
    "market_definition": {"type": "object"},
    "competitive_landscape": {"type": "object"},
    "competitor_profiles": {"type": "array", "items": {"type": "object"}},
    "product_intelligence": {"type": "object"},
    "pricing": {"type": "object"},
    "customer_research": {"type": "object"},
    "voc": {"type": "object"},
    "gtm": {"type": "object"},
    "strategic_signals": {"type": "object"},
    "opportunities": {"type": "array", "items": {"type": "object"}},
    "contradictions": {"type": "array", "items": {"type": "object"}},
    "verification_summary": {"type": "object"},
    "red_team": {"type": "object"},
    "recommendations": {"type": "array", "items": {"type": "object"}},
    "where_not_to_compete": {"type": "array", "items": {"type": "object"}},
    "next_validation": {"type": "array", "items": {"type": "object"}},
    "data_gaps": {"type": "array", "items": {"type": "object"}},
    "claim_ids": {"type": "array", "items": {"type": "string"}},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "generated_at": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
