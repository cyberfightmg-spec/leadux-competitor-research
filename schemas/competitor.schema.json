{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leaduxai.id/schemas/competitor.schema.json",
  "title": "LeadUX Competitor",
  "type": "object",
  "required": ["entity_id", "name", "type", "tier", "relevance_score", "classification_confidence"],
  "properties": {
    "entity_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "brand_name": {"type": ["string", "null"]},
    "legal_name": {"type": ["string", "null"]},
    "official_url": {"type": ["string", "null"]},
    "type": {"enum": ["DIRECT", "INDIRECT", "SUBSTITUTE", "DIY", "ADJACENT"]},
    "tier": {"enum": ["A", "B", "C"]},
    "relevance_score": {"type": "number", "minimum": 0, "maximum": 100},
    "classification_confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "classification_reason": {"type": ["string", "null"]},
    "geography": {"type": "array", "items": {"type": "string"}},
    "geographic_role": {
      "enum": ["NATIONAL", "MULTI_REGIONAL", "REGIONAL", "LOCAL", "ONLINE_ONLY", "UNKNOWN"]
    },
    "geographic_presence": {
      "type": "object",
      "properties": {
        "registered_region": {"type": ["string", "null"]},
        "headquarters": {"type": ["string", "null"]},
        "national_coverage": {"type": ["boolean", "null"]},
        "physical_locations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "region": {"type": ["string", "null"]},
              "city": {"type": ["string", "null"]},
              "address": {"type": ["string", "null"]},
              "source_ids": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          }
        },
        "service_regions": {"type": "array", "items": {"type": "string"}},
        "verified_regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["region", "presence_type", "confidence"],
            "properties": {
              "region": {"type": "string"},
              "cities": {"type": "array", "items": {"type": "string"}},
              "presence_type": {"enum": ["OFFICE", "BRANCH", "SERVICE", "ONLINE", "PARTNER", "UNKNOWN"]},
              "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
              "source_ids": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "target_segments": {"type": "array", "items": {"type": "string"}},
    "jtbd": {"type": "array", "items": {"type": "string"}},
    "identity": {
      "type": "object",
      "properties": {
        "inn": {"type": ["string", "null"]},
        "ogrn": {"type": ["string", "null"]},
        "region": {"type": ["string", "null"], "description": "Legacy registration/identity region field. Do not treat as service coverage."}
      },
      "additionalProperties": true
    },
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["active", "inactive", "uncertain", "not_checked"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
