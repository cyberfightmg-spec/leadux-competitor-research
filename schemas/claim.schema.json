{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim",
  "type": "object",
  "required": ["id", "text", "evidence_type", "confidence", "source_ids"],
  "properties": {
    "id": {"type": "string"},
    "text": {"type": "string"},
    "evidence_type": {"enum": ["FACT", "ESTIMATE", "HYPOTHESIS", "ASSUMPTION", "NOT_FOUND"]},
    "entity_id": {"type": ["string", "null"]},
    "dimension": {"type": ["string", "null"]},
    "value": {},
    "unit": {"type": ["string", "null"]},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "observed_at": {"type": ["string", "null"], "format": "date"},
    "scope": {"type": "object"},
    "calculation": {"type": ["object", "null"]},
    "verification_status": {"enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED", "CONTRADICTED", null]}
  }
}
